{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bloom",
  "version": "0.0.1",
  "identifier": "com.bloom.shell",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "capabilities": [
        {
          "identifier": "bloom-shell",
          "description": "Local Bloom windows may show and hide the pie menu.",
          "windows": ["main", "pie"],
          "remote": { "urls": ["http://127.0.0.1:1420/*"] },
          "permissions": ["core:default"]
        }
      ]
    }
  },
  "bundle": { "active": false, "icon": ["icons/128x128.png"] }
}
