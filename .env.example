# Copy to .env (ignored by git). Nothing is required for make run, make check or make bench.

# Decision backends, in order of preference (names from bloom/decision/adapters/BACKENDS)
BLOOM_DECISION_BACKENDS=rules

# Local run log (contains personal data: never commit it)
BLOOM_AUDIT_PATH=.bloom/audit.jsonl

# Hosted model keys (from v0.2)
JEV_API_KEY=
LLM_API_KEY=
