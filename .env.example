# Copier en .env (ignoré par git). Rien n'est obligatoire pour make run, make check ou make bench.

# Backends de décision, par ordre de préférence (noms de bloom/decision/adapters/BACKENDS)
BLOOM_DECISION_BACKENDS=rules

# Journal local des runs (contient des données personnelles : ne jamais le commiter)
BLOOM_AUDIT_PATH=.bloom/audit.jsonl

# Clés des modèles hébergés (à partir de la v0.2)
JEV_API_KEY=
LLM_API_KEY=
