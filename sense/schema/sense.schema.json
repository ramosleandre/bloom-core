      "description": "A fact reported by a source, in OS terms. Sources do not interpret, rank or normalize.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "name",
            "pid",
            "raw_id",
            "type"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "pid": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            },
            "raw_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "app_seen"
              ]
            }
          }
        },
        {
          "type": "object",
