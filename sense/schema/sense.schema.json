              "default": null,
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0.0
            },
            "editable": {
              "default": false,
              "type": "boolean"
            },
            "label": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
