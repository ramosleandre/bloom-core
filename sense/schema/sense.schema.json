              "type": "boolean"
            },
            "fullscreen": {
              "default": false,
              "type": "boolean"
            },
            "key": {
              "type": "string"
            },
            "pid": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            },
            "private": {
              "default": false,
              "type": "boolean"
            },
            "title": {
              "default": null,
