                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "enum": [
                "window_seen"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "key",
            "type"
          ],
          "properties": {
            "key": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "window_gone"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
